# Import contracts for myenergy (docs/standards/project/architecture.md).
[importlinter]
root_package = myenergy
include_external_packages = True

[importlinter:contract:layers]
name = Layers depend downwards only (MEO-ARC-2)
type = layers
layers =
    myenergy.bootstrap
    myenergy.api | myenergy.adapters
    myenergy.engine | myenergy.policies
    myenergy.ports
    myenergy.domain

[importlinter:contract:pure-domain]
name = The domain is pure (MEO-ARC-1)
type = forbidden
source_modules =
    myenergy.domain
    myenergy.ports
forbidden_modules =
    clingo
    dishka
    fastapi
    httpx
    pandas
    pydantic
    smartmdao
    structlog

[importlinter:contract:core-has-no-io]
name = Engine and policies reach the outside only through ports (MEO-ARC-3)
type = forbidden
source_modules =
    myenergy.engine
    myenergy.policies
forbidden_modules =
    myenergy.adapters
    myenergy.api
    clingo
    dishka
    fastapi
    httpx
    pandas

[importlinter:contract:edges-stay-apart]
name = Adapters and the API never reach into the core (MEO-ARC-4)
type = forbidden
source_modules =
    myenergy.adapters
    myenergy.api
forbidden_modules =
    myenergy.engine
    myenergy.policies

[importlinter:contract:no-test-imports]
name = Production code never imports test code (ARC-5)
type = forbidden
source_modules = myenergy
forbidden_modules =
    pytest
    hypothesis
